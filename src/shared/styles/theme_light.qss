/* ============================================
   TermiPDF — Edge Light Theme
   ============================================ */

QWidget {
    background-color: #fafafa;
    color: #1f1f1f;
    font-family: "Segoe UI", "JetBrains Mono", "Consolas", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #f0f0f0;
}

/* ---------- Toolbar ---------- */
QToolBar#MainBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e0e0e0;
    spacing: 0;
    padding: 0;
}
QToolBar#MainBar::separator {
    background-color: #e0e0e0;
    width: 1px;
    margin: 6px 4px;
}
QToolBar QToolButton {
    background-color: transparent;
    color: #1f1f1f;
    border: none;
    border-radius: 4px;
    min-width: 36px;
    min-height: 36px;
    padding: 0;
    margin: 4px 2px;
}
QToolBar QToolButton:hover  { background-color: #e8e8e8; color: #0067c0; }
QToolBar QToolButton:pressed{ background-color: #d8d8d8; }
QToolBar QToolButton:checked{ background-color: #cce4f7; color: #0067c0; border: 1px solid #99c2eb; }
QToolBar QToolButton:disabled{ color: #b0b0b0; }

QToolBar QLabel#toolbarLabel {
    color: #5f5f5f;
    padding: 0 6px;
}

QToolBar QLineEdit {
    background-color: #f5f5f5;
    color: #1f1f1f;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    max-height: 30px;
    min-width: 160px;
}

/* ---------- Menubar ---------- */
QMenuBar {
    background-color: #ffffff;
    color: #1f1f1f;
    border-bottom: 1px solid #e0e0e0;
    padding: 2px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected { background-color: #e8e8e8; }

QMenu {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #d0d0d0;
    padding: 4px;
}
QMenu::item {
    padding: 5px 22px;
    border-radius: 4px;
}
QMenu::item:selected { background-color: #e8e8e8; }

/* ---------- Dock ---------- */
QDockWidget { color: #1f1f1f; titlebar-close-icon: none; titlebar-normal-icon: none; }
QDockWidget::title {
    background-color: #f5f5f5;
    padding: 6px 8px;
    border-bottom: 1px solid #e0e0e0;
    text-align: left;
    font-weight: bold;
}
QDockWidget > QWidget { background-color: #ffffff; }
QToolButton#dockHandle { background: transparent; border: none; padding: 0 4px; color: #888; }
QToolButton#dockHandle:hover { color: #1f1f1f; }
QToolButton#dockPosition {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px;
    color: #888;
}
QToolButton#dockPosition:hover { background-color: #e8e8e8; color: #1f1f1f; }
QToolButton#dockPosition:checked { background-color: #cce4f7; color: #0067c0; }

/* ---------- Splitter ---------- */
QSplitter::handle { background-color: #e0e0e0; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical   { height: 3px; }

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #0067c0;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: bold;
}
QPushButton:hover { background-color: #1a78c8; }
QPushButton:pressed { background-color: #00529b; }
QPushButton#danger { background-color: #c42b1c; color: #ffffff; }
QPushButton#danger:hover { background-color: #d34030; }
QPushButton#flat {
    background-color: transparent;
    color: #1f1f1f;
    border: 1px solid #d0d0d0;
    padding: 4px 10px;
    font-weight: normal;
}
QPushButton#flat:hover { background-color: #e8e8e8; }

/* ---------- Inputs ---------- */
QLineEdit {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 6px;
    selection-background-color: #cce4f7;
}
QLineEdit:focus { border: 1px solid #0067c0; }

QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #cce4f7;
}

/* ---------- Tree (TOC) ---------- */
QTreeWidget, QTreeView {
    background-color: #ffffff;
    alternate-background-color: #fafafa;
    color: #1f1f1f;
    border: 1px solid #e0e0e0;
    selection-background-color: #cce4f7;
    selection-color: #0067c0;
    outline: 0;
}
QTreeWidget::item, QTreeView::item { padding: 4px 6px; border-radius: 3px; }
QTreeWidget::item:hover, QTreeView::item:hover { background-color: #e8e8e8; }
QHeaderView::section {
    background-color: #f5f5f5;
    color: #1f1f1f;
    padding: 4px;
    border: none;
}

/* ---------- List ---------- */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    color: #1f1f1f;
    outline: 0;
}
QListWidget::item {
    background-color: #fafafa;
    border: 2px solid transparent;
    border-radius: 4px;
    padding: 4px;
}
QListWidget::item:selected {
    background-color: #cce4f7;
    border: 2px solid #0067c0;
}
QListWidget::item:hover { background-color: #f0f0f0; }

/* ---------- Tabs ---------- */
QTabWidget::pane { border: none; }
QTabBar::tab {
    background-color: transparent;
    color: #5f5f5f;
    padding: 6px 14px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: #1f1f1f; border-bottom: 2px solid #0067c0; }
QTabBar::tab:hover { color: #1f1f1f; }

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c0c0c0;
    min-height: 24px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover { background: #a0a0a0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #f0f0f0;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #c0c0c0;
    min-width: 24px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover { background: #a0a0a0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- Status bar ---------- */
QStatusBar {
    background-color: #f5f5f5;
    color: #5f5f5f;
    border-top: 1px solid #e0e0e0;
}
QStatusBar QLabel#pageIndicator { color: #0067c0; font-weight: bold; padding: 0 12px; }
QStatusBar QLabel#zoomIndicator { color: #5f5f5f; padding: 0 12px; }
QStatusBar QLabel#modeBadge {
    color: #ffffff;
    background-color: #0067c0;
    padding: 2px 8px;
    border-radius: 3px;
    font-weight: bold;
}
QStatusBar::item { border: none; }

/* ---------- Labels ---------- */
QLabel#statusLabel { color: #0067c0; font-weight: bold; }
QLabel#modeLabel   { color: #0067c0; font-weight: bold; padding: 2px 8px; border-radius: 3px; background-color: #e8e8e8; }

/* ---------- Swatches ---------- */
QFrame#swatch { border: 2px solid transparent; border-radius: 4px; }
QFrame#swatch[active="true"] { border: 2px solid #1f1f1f; }
QFrame#swatch[category="pen"]:hover        { border: 2px solid #0067c0; }
QFrame#swatch[category="highlight"]:hover { border: 2px solid #f9c83d; }

/* ---------- Find bar ---------- */
QFrame#findBar {
    background-color: #f5f5f5;
    border-bottom: 1px solid #e0e0e0;
}
QFrame#findBar QLabel { color: #5f5f5f; padding: 0 6px; }
QFrame#findBar QLineEdit {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #d0d0d0;
    max-height: 28px;
}

/* ---------- Tooltip ---------- */
QToolTip {
    background-color: #1f1f1f;
    color: #ffffff;
    border: 1px solid #404040;
    padding: 4px 6px;
}