# ---- Python -------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

*.pyd
*.egg-info/
.venv/
venv/

# ---- OS junk ------------------------------------------------------------
.DS_Store
Thumbs.db

# ---- Editor / IDE -------------------------------------------------------
.idea/
.vscode/
*.swp

# ---- Screenshot tooling (kept on disk for maintainers, hidden on GitHub) -
# The 12 gallery PNGs in docs/screenshots/ ARE tracked so the README renders
# on GitHub for every visitor. Only the helpers + scratch outputs are hidden:
tests/capture_screenshots.py
tests/capture_real_app.py
tests/capture_lightmode_debug.py
tests/make_demo_pdf.py
docs/screenshots/_assets/_seed.png
docs/screenshots/_assets/demo.pdf
docs/screenshots/_assets/from_images.pdf
docs/screenshots/debug_*.png

# ---- App scratch (never commit user data) -------------------------------
*.autosave
*.tmp

# ---- Snap build artefacts ----------------------------------------------
# Snapcraft keeps its caches and built .snap files inside the project
# tree when you run `snapcraft` locally. Never commit them.
*.snap
snap/.snapcraft/
parts/
_stage/
prime/
_build/
*.snap.keep

# ---- Debian package build artefacts ------------------------------------
# dpkg-buildpackage drops the .deb + .changes + .buildinfo into the
# parent dir. Never commit them — regenerate per release.
*.deb
*.changes
*.buildinfo
debian/files
debian/debhelper.log
debian/*.substvars
debian/*.debhelper
